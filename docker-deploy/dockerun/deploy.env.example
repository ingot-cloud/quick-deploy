# Dockerun 单容器部署配置，供根目录 deploy.sh 使用。
# 复制为 deploy.env；真实配置不会提交 Git，也不会进入镜像构建上下文。
# 每行 KEY=value，可用单引号或双引号包住整个值；值按字面量读取。
# 不执行变量插值、转义或命令替换；注释必须单独占一行。
# 已导出的环境变量优先于文件中的同名值。

CONTAINER_NAME=dockerun
IMAGE_NAME=docker-registry.ingotcloud.top/ingot/dockerun:2.0.0
# never：只用本地镜像；missing：本地缺失时拉取；always：部署前总是拉取。
PULL_POLICY=never
RESTART_POLICY=unless-stopped

# 使用 nginx-proxy 已连接的现有网络；附加数据库网络用空格分隔。
DOCKER_NETWORK=ingot-net
ADDITIONAL_NETWORKS=
DOCKER_SOCKET=/var/run/docker.sock
# 同一路径挂载到容器内，保证宿主 Docker 能读取 Compose 文件及配置。
# 使用 MySQL 仍需持久化此目录中的仓库镜像、密钥和发布材料。
DATA_DIR=/var/lib/dockerun

# 默认通过 nginx-proxy 访问。HOST_PORT 留空则不映射宿主端口。
HOST_BIND_IP=127.0.0.1
HOST_PORT=
PUBLIC_URL=https://dockerun.example.com
VIRTUAL_HOST=dockerun.example.com
# 沿用 acme-companion 2.6 的自动证书配置；使用已有证书时留空。
LETSENCRYPT_HOST=dockerun.example.com
LETSENCRYPT_EMAIL=

# 升级旧 MySQL 安装时填写原连接，先备份并在数据库副本验证迁移。
DATABASE_TYPE=mysql
MYSQL_DSN=
# MYSQL_DSN='dockerun:实际密码@tcp(mysql.example.com:3306)/dockerun?charset=utf8mb4&parseTime=True&loc=Local'
# 新安装可改为 DATABASE_TYPE=sqlite，MYSQL_DSN 留空。

# 首次升级包含数据库备份与迁移，预留足够的启动等待时间。
STARTUP_TIMEOUT=600
STOP_TIMEOUT=30
LOG_TAIL=100

# 不设置时，新版签名与凭据密钥自动生成到 DATA_DIR/keys 并持久化。
# 原部署若显式设置过以下密钥，升级时继续填写原值。
# JWT_SECRET=
# REGISTRY_SECRET=
# REGISTRY_HTTP_SECRET=
# CREDENTIALS_SECRET=
# AES_KEY=
# AES_IV=
